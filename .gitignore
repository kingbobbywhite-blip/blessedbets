# v0 runtime files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts

# Common ignores
node_modules
.next/
.env*.local
.DS_Store
# Odds feed key, if you use a local env file
.env

# TypeScript incremental build cache
*.tsbuildinfo

# Written by `next dev` when agentRules is enabled
/AGENTS.md

# Regenerated by `next dev` / `next build` on every run.
# Tracking it makes every pull conflict for anyone who has run the app.
next-env.d.ts

# Any env file but the example: .env.production or .env.development holding a
# real key would otherwise be committed, since only .env and .env*.local were
# covered.
.env*
!.env.example

# Vercel CLI link and pulled env files.
.vercel
