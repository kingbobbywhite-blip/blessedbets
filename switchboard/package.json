{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to every Claude Code session from one place: a hub that starts and steers sessions in tmux, pushes your messages into them through Claude Code channels, keeps every message and a task backlog in Postgres, and speaks replies on your phone.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "switchboard": "bin/switchboard"
  },
  "scripts": {
    "start": "node src/hub/main.ts",
    "cli": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.8",
    "htm": "^3.1.1",
    "pg": "^8.23.1",
    "preact": "^11.2.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "ws": "^8.22.2"
  }
}
