# Switchboard settings. Copy to switchboard/.env (or ~/.switchboard/.env) and fill in.
# Everything is optional except where noted.

# The address your phone and Flic button use to reach the hub. With Tailscale:
#   tailscale serve --bg 7700     ->  https://<this-computer>.<tailnet>.ts.net
SWITCHBOARD_PUBLIC_URL=

# Where the hub listens. Keep 127.0.0.1 behind `tailscale serve`; use 0.0.0.0 only on a network you trust.
SWITCHBOARD_HOST=127.0.0.1
SWITCHBOARD_PORT=7700

# Postgres. Leave empty to run the embedded Postgres that ships with the package (data in ~/.switchboard/postgres).
# Or point at your own: postgres://user:pass@localhost:5432/switchboard
DATABASE_URL=

# Speech to text on the hub (otherwise phones and browsers transcribe on the device).
# Any OpenAI-compatible endpoint works: OpenAI, Groq, or a local server such as speaches.
OPENAI_API_KEY=
# GROQ_API_KEY=
# STT_BASE_URL=http://localhost:8000/v1
# STT_MODEL=Systran/faster-whisper-small

# The orchestrator session's name and working folder (default: switchboard/orchestrator).
SWITCHBOARD_ORCHESTRATOR=boss
# SWITCHBOARD_ORCHESTRATOR_CWD=~/code

# Extra flags for every session the hub starts, e.g. --permission-mode acceptEdits
SWITCHBOARD_CLAUDE_ARGS=

# Answer Claude Code's "loading development channels" and "trust this folder" prompts
# when the hub starts a session for you. Set to 0 to answer them yourself.
SWITCHBOARD_AUTO_ACCEPT_DIALOGS=1

# The token is generated on first run and kept in ~/.switchboard/token. Set it here to choose your own.
# SWITCHBOARD_TOKEN=

# Optional: Expo access token for push notifications when the app is closed (see mobile/README.md).
# EXPO_ACCESS_TOKEN=
